@{
    ViewData["Title"] = "Panel Principal";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="bg-primary text-white p-4 text-center">
                    <div class="display-5 mb-2">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <h2 class="fw-bold mb-1">¡Bienvenido de nuevo, @ViewBag.NombreEstudiante!</h2>
                    <p class="text-white-50 mb-0">Sistema de Autenticación y Control de Acceso (Login MVC)</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-shield-lock-fill fs-3 me-3 text-success"></i>
                        <div>
                            <strong>Autenticación exitosa:</strong> Accediste a la vista protegida del sistema. La contraseña fue verificada mediante cifrado <strong>BCrypt</strong>.
                        </div>
                    </div>

                    <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-info-circle me-1"></i> Información del Usuario Conectado</h5>
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered table-striped align-middle">
                            <tbody>
                                <tr>
                                    <th scope="row" style="width: 35%;">Nombre del Integrante</th>
                                    <td class="fw-semibold text-primary">@ViewBag.NombreEstudiante</td>
                                </tr>
                                <tr>
                                    <th scope="row">Nickname / Usuario</th>
                                    <td><code>@ViewBag.Nickname</code></td>
                                </tr>
                                <tr>
                                    <th scope="row">Correo Electrónico</th>
                                    <td>@ViewBag.Correo</td>
                                </tr>
                                <tr>
                                    <th scope="row">Base de Datos</th>
                                    <td><code>DB_LOGIN_PROYECT (SQL Server)</code></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top">
                        <span class="text-muted small">
                            <i class="bi bi-mortarboard-fill me-1"></i> Universidad Panamericana (UPANA)
                        </span>
                        <form asp-controller="Access" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión (Logout)
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
