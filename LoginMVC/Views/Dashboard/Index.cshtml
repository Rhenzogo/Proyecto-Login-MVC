@{
    ViewData["Title"] = "Dashboard - Panel Principal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }
        .navbar-custom {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        }
        .welcome-card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            background: #ffffff;
        }
        .avatar-circle {
            width: 80px;
            height: 80px;
            background: #e7f1ff;
            color: #0d6efd;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            margin: 0 auto 1.5rem;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">
                <i class="bi bi-shield-check me-2"></i>Sistema Login MVC
            </a>
            <div class="d-flex align-items-center">
                <span class="navbar-text text-white me-3 d-none d-md-inline">
                    <i class="bi bi-person-circle me-1"></i> @ViewBag.NombreCompleto (@ViewBag.Nickname)
                </span>
                <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Contenido Principal -->
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card welcome-card p-4 p-md-5 text-center">
                    <div class="avatar-circle">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    
                    <h2 class="fw-bold text-dark mb-2">¡Bienvenido de nuevo, @ViewBag.NombreCompleto!</h2>
                    <p class="text-muted mb-4">Has iniciado sesión satisfactoriamente en el sistema protegido.</p>

                    <div class="card bg-light border-0 text-start p-3 mb-4 rounded-3">
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-info-circle me-1"></i> Datos de la sesión autenticada:</h6>
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2"><strong>Nombre completo:</strong> @ViewBag.NombreCompleto</li>
                            <li class="mb-2"><strong>Usuario / Nickname:</strong> <code>@ViewBag.Nickname</code></li>
                            <li class="mb-2"><strong>Correo electrónico:</strong> @ViewBag.Correo</li>
                            <li><strong>Seguridad de credenciales:</strong> <span class="badge bg-success"><i class="bi bi-lock-fill"></i> BCrypt Hash Verified</span></li>
                        </ul>
                    </div>

                    <div class="d-flex justify-content-center gap-3">
                        <form asp-action="Logout" asp-controller="Account" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión (Logout)
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
