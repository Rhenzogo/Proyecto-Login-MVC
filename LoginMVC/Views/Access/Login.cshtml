@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Control de Acceso</title>
    <!-- Bootstrap CSS y Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #0d1b2a 0%, #1b263b 50%, #415a77 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 1.5rem;
        }

        .login-card {
            background: #ffffff;
            border-radius: 1.25rem;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
            width: 100%;
            max-width: 440px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            animation: slideUp 0.5s ease-out;
        }

        .login-header {
            background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
            color: #ffffff;
            padding: 2.5rem 2rem 2rem;
            text-align: center;
        }

        .login-icon-box {
            width: 80px;
            height: 80px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(5px);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

        .login-icon-box i {
            font-size: 2.5rem;
            color: #ffffff;
        }

        .login-body {
            padding: 2rem 2.25rem 2.25rem;
        }

        .form-floating > .form-control {
            border-radius: 0.75rem;
            border: 1.5px solid #dee2e6;
            padding-left: 1rem;
            transition: all 0.25s ease-in-out;
        }

        .form-floating > .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }

        .btn-login {
            background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
            border: none;
            border-radius: 0.75rem;
            padding: 0.85rem;
            font-weight: 600;
            font-size: 1.05rem;
            letter-spacing: 0.3px;
            transition: all 0.3s ease;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(13, 110, 253, 0.35);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(25px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <div class="login-card">
        <!-- Encabezado con Icono y Títulos -->
        <div class="login-header">
            <div class="login-icon-box">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h3 class="fw-bold mb-1">Iniciar Sesión</h3>
            <p class="mb-0 text-white-50 small">Sistema de Autenticación y Control de Acceso (MVC)</p>
        </div>

        <div class="login-body">
            <!-- Mensaje de Error en caso de credenciales fallidas -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center rounded-3 p-3 mb-4 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-octagon-fill flex-shrink-0 me-2 fs-5"></i>
                    <div class="small fw-semibold">
                        @ViewBag.Error
                    </div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Formulario Responsivo -->
            <form asp-action="Login" asp-controller="Access" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <!-- Campo Usuario / Nickname o Correo -->
                <div class="form-floating mb-3">
                    <input type="text" 
                           name="nickname" 
                           id="nickname" 
                           class="form-control" 
                           placeholder="ejemplo@upana.edu.gt" 
                           required 
                           autofocus />
                    <label for="nickname">
                        <i class="bi bi-person-fill text-muted me-1"></i> Usuario / Nickname o Correo
                    </label>
                </div>

                <!-- Campo Contraseña -->
                <div class="form-floating mb-3 position-relative">
                    <input type="password" 
                           name="password" 
                           id="password" 
                           class="form-control" 
                           placeholder="Contraseña" 
                           required />
                    <label for="password">
                        <i class="bi bi-key-fill text-muted me-1"></i> Contraseña
                    </label>
                </div>

                <!-- Recordar Sesión -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input type="checkbox" name="keepLoggedIn" id="keepLoggedIn" value="true" class="form-check-input" />
                        <label for="keepLoggedIn" class="form-check-label text-muted small user-select-none">
                            Mantener sesión activa
                        </label>
                    </div>
                </div>

                <!-- Botón de Inicio de Sesión -->
                <button type="submit" class="btn btn-login btn-primary w-100 shadow">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Ingresar al Sistema
                </button>
            </form>
        </div>
    </div>

    <!-- Scripts Bootstrap -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
